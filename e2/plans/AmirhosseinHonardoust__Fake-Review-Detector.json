  },
  {
   "case_id": "C-ENV",
   "family": "C-ENV",
   "intent": "control",
   "env": {
    "REPROMUT_UNUSED_VAR": "1"
   }
  },
  {
   "case_id": "C-CACHE",
   "family": "C-CACHE",
   "intent": "control"
  },
  {
   "case_id": "C-PATH",
   "family": "C-PATH",
   "intent": "control"
  },
  {
   "case_id": "C-DEP",
   "family": "C-DEP",
   "intent": "control",
   "image_key": "dep_patch"
  }
 ]
}