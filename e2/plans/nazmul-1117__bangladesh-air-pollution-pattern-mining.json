   },
   "capture": {
    "data/processed/air_quality_cleaned.csv": "stale_cleaned.csv"
   }
  }
 ],
 "cases": [
  {
   "case_id": "M-CACHE-1",
   "family": "M-CACHE",
   "intent": "positive",
   "pre_files": {
    "data/processed/air_quality_cleaned.csv": "stale_cleaned.csv"
   },
   "note": "cleaned CSV produced by preprocess.py from the first 90% of raw rows"
  },
  {
   "case_id": "M-PATH-1",
   "family": "M-PATH",
   "intent": "positive",
   "shadow_files": {
    "data/processed/air_quality_cleaned.csv": "cleaned_p90.csv"
   },
   "note": ""
  },
  {
   "case_id": "C-ENV",
   "family": "C-ENV",
   "intent": "control",
   "env": {
    "REPROMUT_UNUSED_VAR": "1"
   }
  },
  {
   "case_id": "C-CACHE",
   "family": "C-CACHE",
   "intent": "control"
  },
  {
   "case_id": "C-PATH",
   "family": "C-PATH",
   "intent": "control"
  },
  {
   "case_id": "C-DEP",
   "family": "C-DEP",
   "intent": "control",
   "image_key": "dep_patch"
  }
 ]
